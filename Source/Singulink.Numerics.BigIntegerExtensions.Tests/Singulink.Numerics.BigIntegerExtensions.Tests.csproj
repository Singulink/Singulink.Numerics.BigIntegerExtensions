<Project Sdk="MSTest.Sdk/4.5.1">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <!-- .NET 11 changed BigInteger internals so also run tests on it when the SDK in use supports it -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <NoWarn>1591</NoWarn>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="stylecop.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Singulink.Numerics.BigIntegerExtensions\Singulink.Numerics.BigIntegerExtensions.csproj">
      <Aliases>BigIntegerExtensionsAssembly</Aliases>
    </ProjectReference>
  </ItemGroup>
</Project>
